# Os manifestos conferem os bytes exatos das evidencias publicadas.
docs/evidencias/fase3/** -text
# SVGs gerados usam CRLF e espacos nos atributos; manter os bytes selados.
docs/evidencias/fase3/**/analysis/figures/*.svg whitespace=cr-at-eol,-blank-at-eol
